# ============================================
# Node.js & Package Managers
# ============================================
node_modules/
**/node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Environment Variables (NEVER COMMIT)
# ============================================
.env
.env.local
.env.*.local
!.env.example
.env.test
.env.production
.env.production.local

# ============================================
# Build & Dist Outputs
# ============================================
dist/
build/
.out/
.vite/
.cache/
outputs/
/frontend/dist/
/frontend/.vite/
/frontend/.cache/
/backend/dist/
/backend/build/
/backend/.cache/

# ============================================
# Test & Coverage
# ============================================
coverage/
.nyc_output/
*.lcov
.mocha_output

# ============================================
# Logs & Temporary Files
# ============================================
logs/
*.log
*.log.*
tmp/
temp/
.DS_Store

# ============================================
# IDE & Editor Files (NEVER COMMIT)
# ============================================
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
.vim/
.emacs.d/
*.swp
*.swo
*~
.project
.classpath
.c9/
.AppleDouble
.LSOverride

# ============================================
# OS-Specific Files
# ============================================
Thumbs.db
ehthumbs.db
desktop.ini

# ============================================
# Runtime & Process Files
# ============================================
*.pid
*.pid.lock
*.seed*

# Ignore large seed output files and generated data
/backend/seed/*.json
/backend/seed/*.ndjson
/backend/seed/*.dump
/backend/seed/*.archive
/backend/seed/data/
/dev-seed/

# Ignore any exported database dumps
*.dump
*.bson
*.archive

# ============================================
# Certificates & Credentials (NEVER COMMIT)
# ============================================
*.pem
*.key
*.cert
*.csr

# ============================================
# MongoDB & Database
# ============================================
.mongorc.js
.mongodb/

# ============================================
# Misc
# ============================================
*.local
.turbo/
.parcel-cache/
dist-ssr/
*.tsbuildinfo
.eslintcache
.sass-cache
.cacache/
.next/
